#!/usr/bin/env bash
set -euo pipefail

if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' '错误：未找到 python3，无法校验提交描述；提交已阻止。请安装 Python 3 并确保 python3 在 PATH 中。' >&2
  exit 1
fi

IFS= read -r subject < "$1" || [[ -n "$subject" ]]
pattern='^(功能|修复|文档|样式|重构|性能|测试|构建|持续集成|杂项|回滚|feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\([a-z0-9][a-z0-9._/-]*\): [^[:space:]].*$'
if [[ ! "$subject" =~ $pattern ]]; then
  printf '%s\n' '提交标题须为 类型(scope): 描述，使用半角括号和冒号，scope 不能为空。' >&2
  exit 1
fi

description=${subject#*: }
if ! printf '%s' "$description" | python3 -c 'import sys; text = sys.stdin.buffer.read().decode("utf-8"); sys.exit(not any("\u4e00" <= char <= "\u9fff" for char in text))'; then
  printf '%s\n' '提交描述须至少包含一个中文汉字。' >&2
  exit 1
fi
