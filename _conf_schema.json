{
  "enabled": {
    "description": "签到服务开关",
    "type": "bool",
    "default": false,
    "hint": "关闭时不接受签到或自动触发；先配置任务、准备制品、录入凭据并启用 Neo，再开启服务。"
  },
  "plugin_admin_qqs": {
    "description": "插件附加管理员 QQ 列表",
    "type": "list",
    "default": [],
    "hint": "附加管理员无需加入白名单；授权仅适用于普通 QQ 私聊。"
  },
  "whitelist_qqs": {
    "description": "普通用户 QQ 白名单",
    "type": "list",
    "default": [],
    "hint": "空白名单不放行普通用户；框架管理员和附加管理员无需加入白名单；授权仅适用于普通 QQ 私聊。"
  },
  "timezone": {
    "description": "签到计划时区",
    "type": "string",
    "default": "Asia/Shanghai",
    "hint": "使用 IANA 时区名称，例如 Asia/Shanghai。"
  },
  "timeout_seconds": {
    "description": "任务默认超时秒数",
    "type": "int",
    "default": 180,
    "hint": "允许 1 到 240 秒；任务中的 0 表示继承此值。"
  },
  "manual_cooldown_seconds": {
    "description": "同一任务手动签到冷却秒数",
    "type": "int",
    "default": 300,
    "hint": "按本人任务绑定计算，从实际参与手动请求的执行与清理完成时开始；自动任务不受该冷却限制，0 表示不等待。"
  },
  "queue_expiry_seconds": {
    "description": "排队请求有效期秒数",
    "type": "int",
    "default": 900,
    "hint": "排队超过该时长仍未开始时记为取消，不再执行；从请求入队时开始计算，0 表示入队后立即到期。"
  },
  "history_retention_days": {
    "description": "执行历史保留天数",
    "type": "int",
    "default": 30,
    "hint": "只清理已结束且通知已结算的记录；排队、运行和通知未完成的记录保留，0 表示下次清理时移除已结算记录。"
  },
  "user_interval": {
    "description": "同一任务换用户签到间隔",
    "type": "object",
    "default": {
      "mode": "random",
      "min_seconds": 30,
      "max_seconds": 60
    },
    "hint": "仅当最近完成记录为同一任务、下一条用户不同时使用；只参考最近一次全局完成记录，跳过或未执行不改变起点。支持 fixed、random 和 none，0 表示无间隔。",
    "items": {
      "mode": {
        "description": "间隔模式",
        "type": "string",
        "default": "random",
        "options": [
          "fixed",
          "random",
          "none"
        ]
      },
      "seconds": {
        "description": "固定间隔秒数",
        "type": "int",
        "default": 60
      },
      "min_seconds": {
        "description": "随机间隔下限秒数",
        "type": "int",
        "default": 30
      },
      "max_seconds": {
        "description": "随机间隔上限秒数",
        "type": "int",
        "default": 60
      }
    }
  },
  "task_interval": {
    "description": "切换任务签到间隔",
    "type": "object",
    "default": {
      "mode": "fixed",
      "seconds": 60
    },
    "hint": "下一条任务与最近完成记录不同时使用，且不叠加用户间隔；只参考最近一次全局完成记录，跳过或未执行不改变起点。支持 fixed、random 和 none，0 表示无间隔。",
    "items": {
      "mode": {
        "description": "间隔模式",
        "type": "string",
        "default": "fixed",
        "options": [
          "fixed",
          "random",
          "none"
        ]
      },
      "seconds": {
        "description": "固定间隔秒数",
        "type": "int",
        "default": 60
      },
      "min_seconds": {
        "description": "随机间隔下限秒数",
        "type": "int",
        "default": 30
      },
      "max_seconds": {
        "description": "随机间隔上限秒数",
        "type": "int",
        "default": 60
      }
    }
  },
  "neo_connection": {
    "description": "独立 Neo 执行连接",
    "type": "object",
    "hint": "手动与自动签到都需要启用并通过访问检查；不会启动或修改 Neo 部署。",
    "items": {
      "enabled": {
        "description": "启用 Neo 连接与启动清理",
        "type": "bool",
        "default": false
      },
      "docker_cleanup_confirmed": {
        "description": "已独立验证 Docker Cargo 物理清理",
        "type": "bool",
        "default": false,
        "hint": "须核对版本、bind 路径映射并独立验证宿主资源删除；仅凭 API 404 不足以确认，不支持用它验收 Kubernetes PVC 清理。"
      },
      "endpoint": {
        "description": "备用 Bay API 地址",
        "type": "string",
        "default": "",
        "hint": "优先使用框架已明确配置的完整 Neo 连接；不读取自动部署凭据文件。"
      },
      "profile": {
        "description": "备用 Neo profile",
        "type": "string",
        "default": "python-default"
      },
      "access_key_env": {
        "description": "备用 Bay 密钥环境变量名",
        "type": "string",
        "default": "CLOUD_DRIVE_CHECKIN_NEO_KEY",
        "hint": "只填写环境变量名，不填写密钥值。"
      },
      "ttl": {
        "description": "独立沙箱 TTL 秒数",
        "type": "int",
        "default": 900,
        "hint": "允许 300 到 3600 秒；TTL 不替代清理验证。"
      }
    }
  },
  "tasks": {
    "description": "签到任务模板",
    "type": "template_list",
    "hint": "启用服务与任务后按 Cron 自动入队；手动与自动共用串行队列和已准备的固定天翼制品。",
    "templates": {
      "task": {
        "name": "签到任务",
        "hint": "配置一个固定来源的签到任务。",
        "display_item": "name",
        "hide_hint_in_list": true,
        "items": {
          "task_id": {
            "description": "稳定任务 ID",
            "type": "string",
            "default": ""
          },
          "name": {
            "description": "任务名称",
            "type": "string",
            "default": ""
          },
          "enabled": {
            "description": "配置启用状态",
            "type": "bool",
            "default": false,
            "hint": "启用任务并开启全局服务后按 Cron 自动入队，也允许本人手动执行；修改任务后需重新准备制品。"
          },
          "runtime": {
            "description": "脚本运行时",
            "type": "string",
            "default": "python",
            "options": [
              "python",
              "node"
            ]
          },
          "script_url": {
            "description": "固定提交脚本 URL",
            "type": "string",
            "default": ""
          },
          "source_commit": {
            "description": "固定来源提交",
            "type": "string",
            "default": ""
          },
          "sha256": {
            "description": "脚本 SHA256",
            "type": "string",
            "default": ""
          },
          "cron": {
            "description": "五段 Cron 计划",
            "type": "string",
            "default": "0 0 * * *"
          },
          "user_fields": {
            "description": "用户字段要求",
            "type": "text",
            "default": "[]",
            "editor_mode": true,
            "editor_language": "json",
            "hint": "填写用户字段元数据的 JSON 数组；不要填写实际凭据值。"
          },
          "fixed_env": {
            "description": "固定非秘密环境变量",
            "type": "dict",
            "default": {},
            "items": {}
          },
          "input_adapter": {
            "description": "输入适配器",
            "type": "string",
            "default": "direct_env",
            "options": [
              "direct_env",
              "tianyi_account",
              "mobile_single_account"
            ]
          },
          "result_adapter": {
            "description": "结果适配器",
            "type": "string",
            "default": "json_protocol",
            "options": [
              "json_protocol",
              "process_only",
              "tianyi",
              "mobile_unverified"
            ]
          },
          "dependency_bundle": {
            "description": "依赖包声明",
            "type": "string",
            "default": "",
            "hint": "仅作静态声明；非空不表示依赖已准备完成。"
          },
          "timeout_seconds": {
            "description": "任务超时秒数",
            "type": "int",
            "default": 0,
            "hint": "0 表示继承全局超时；其他值允许 1 到 240。"
          },
          "experimental": {
            "description": "实验任务",
            "type": "bool",
            "default": false
          }
        }
      }
    },
    "default": [
      {
        "__template_key": "task",
        "task_id": "tianyi_cloud",
        "name": "天翼云盘",
        "enabled": false,
        "runtime": "python",
        "script_url": "https://raw.githubusercontent.com/PRSSTRA/astrbot_plugin_cloud_drive_checkin/fcc3857d3fe801a5181c2c8e0472d7bb67faaa99/third_party/tianyi/index.py",
        "source_commit": "fcc3857d3fe801a5181c2c8e0472d7bb67faaa99",
        "sha256": "3c9d4a41f2f4dd718e80352fcf417e324a728df3406c0a333ab4c09f80fb48ec",
        "cron": "10 7 * * *",
        "user_fields": "[{\"field_id\":\"username\",\"label\":\"用户名\",\"env_name\":\"TY_USERNAME\",\"value_type\":\"string\",\"required\":true,\"secret\":true,\"hint\":\"天翼云盘登录用户名\"},{\"field_id\":\"password\",\"label\":\"密码\",\"env_name\":\"TY_PASSWORD\",\"value_type\":\"string\",\"required\":true,\"secret\":true,\"hint\":\"天翼云盘登录密码\"}]",
        "fixed_env": {},
        "input_adapter": "tianyi_account",
        "result_adapter": "tianyi",
        "dependency_bundle": "",
        "timeout_seconds": 0,
        "experimental": false
      },
      {
        "__template_key": "task",
        "task_id": "mobile_cloud_experimental",
        "name": "移动云盘（实验）",
        "enabled": false,
        "runtime": "node",
        "script_url": "https://raw.githubusercontent.com/smallfawn/QLScriptPublic/2d4c26fdc72c3206bb9cf9afc1fb4991d337f888/daily/ydyp.js",
        "source_commit": "2d4c26fdc72c3206bb9cf9afc1fb4991d337f888",
        "sha256": "7c2e9350a05e3a9db541986835e7bee5e12ae25852ec871d9f75e3ce61d72a9b",
        "cron": "20 7 * * *",
        "user_fields": "[{\"field_id\":\"authorization\",\"label\":\"Authorization\",\"env_name\":\"MOBILE_AUTHORIZATION\",\"value_type\":\"string\",\"required\":true,\"secret\":true,\"hint\":\"移动云盘 Authorization\"},{\"field_id\":\"phone\",\"label\":\"手机号\",\"env_name\":\"MOBILE_PHONE\",\"value_type\":\"string\",\"required\":true,\"secret\":true,\"hint\":\"移动云盘手机号\"},{\"field_id\":\"auth_token\",\"label\":\"认证令牌\",\"env_name\":\"MOBILE_AUTH_TOKEN\",\"value_type\":\"string\",\"required\":true,\"secret\":true,\"hint\":\"移动云盘认证令牌\"}]",
        "fixed_env": {},
        "input_adapter": "mobile_single_account",
        "result_adapter": "mobile_unverified",
        "dependency_bundle": "",
        "timeout_seconds": 0,
        "experimental": true
      }
    ]
  }
}
